----
<VirtualHost *:80>
    ServerName app.example.com
    Redirect permanent / https://app.example.com/
</VirtualHost>

<VirtualHost *:443>
    ServerName app.example.com

    SSLEngine on
    SSLCertificateFile /var/lib/nurproxy-agent/certs/app.example.com.crt
    SSLCertificateKeyFile /var/lib/nurproxy-agent/certs/app.example.com.key.plain

    LimitRequestBody 50000000

    <Location />
        AuthType Basic
        AuthName "Restricted: app.example.com"
        AuthUserFile /etc/apache2/nurproxy-auth/app.example.com.htpasswd
        <RequireAll>
            Require ip 10.0.0.0/8
            Require not ip 10.6.6.6/32
            Require valid-user
        </RequireAll>
    </Location>

    Header always set X-Frame-Options "DENY"

    RequestHeader set X-Team "edge"

    RequestHeader set X-Forwarded-Proto https
    ProxyPreserveHost On

    RewriteEngine On
    RewriteCond %{HTTP:Upgrade} =websocket [NC]
    RewriteRule ^/ws\.v1(?:/(.*))?$ wss://[fd00::5]:8443/$1 [P,L]
    ProxyPassMatch ^/api/world$ http://192.168.178.210:80 connectiontimeout=30 timeout=60
    ProxyPassReverse / http://192.168.178.210:80/
    ProxyPassMatch ^/admin$ http://10.0.0.9:8082 connectiontimeout=30 timeout=60
    ProxyPassReverse / http://10.0.0.9:8082/
    ProxyPassMatch ^/admin(?:/.*)?$ http://10.0.0.8:8081 connectiontimeout=30 timeout=60
    ProxyPassReverse / http://10.0.0.8:8081/
    ProxyPassMatch ^/media(?:/.*)?$ http://10.0.0.7:9000 connectiontimeout=30 timeout=60
    ProxyPassReverse / http://10.0.0.7:9000/
    ProxyPassMatch ^/ws\.v1(?:/(.*))?$ https://[fd00::5]:8443/$1 connectiontimeout=30 timeout=60
    ProxyPassReverse /ws.v1/ https://[fd00::5]:8443/

    RewriteEngine On
    RewriteCond %{HTTP:Upgrade} =websocket [NC]
    RewriteCond %{REQUEST_URI} !^/api/world$
    RewriteCond %{REQUEST_URI} !^/admin$
    RewriteCond %{REQUEST_URI} !^/admin(?:/.*)?$
    RewriteCond %{REQUEST_URI} !^/media(?:/.*)?$
    RewriteCond %{REQUEST_URI} !^/ws\.v1(?:/.*)?$
    RewriteRule ^/?(.*)$ ws://10.0.0.4:8080/$1 [P,L]
    ProxyPass / http://10.0.0.4:8080/ connectiontimeout=30 timeout=60
    ProxyPassReverse / http://10.0.0.4:8080/
</VirtualHost>
